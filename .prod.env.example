# =============================================================================
# Production environment template - SmartReach AI
# =============================================================================
# Copy to /opt/smart-reach-ai-prod/.prod.env on the prod EC2 and fill in real
# values:
#
#   sudo cp .prod.env.example /opt/smart-reach-ai-prod/.prod.env
#   sudo chmod 600 /opt/smart-reach-ai-prod/.prod.env
#
# The deploy pipeline copies it into the runner checkout and injects it into
# the backend/worker/scheduler containers (env_file in docker-compose.prod.yml).
#
# NEVER commit the real .prod.env - it is gitignored on purpose.
# Do NOT set IMAGE_TAG here; the pipeline exports it per deploy.
# Values must be plain text (no spaces/quotes) or this file cannot be sourced.
# Domains are pre-filled for reachpulse.medidatalab.com / api.medidatalab.com.
# =============================================================================

# ---- used by docker-compose.prod.yml interpolation (URLs as users see them) ----
API_URL=https://api.medidatalab.com
FRONTEND_URL=https://reachpulse.medidatalab.com
CORS_ORIGINS=https://reachpulse.medidatalab.com

# NEXT_PUBLIC_API_URL is NOT set here - it is a GitHub *Environment* variable
# on the "production" environment (Settings > Environments > production >
# Add variable), baked into the frontend bundle at build time. Set it to
# https://api.medidatalab.com. The prod workflow fails early if it is unset.
DB_NAME=leadgen_db
DB_USER=leadgen_user
DB_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# ---- injected into backend/worker/scheduler containers ----
# REQUIRED - replace CHANGE-ME with real values. Generate with:
#   SECRET_KEY:      python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   ENCRYPTION_KEY:  python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Values must be plain text (no spaces/quotes), or this file cannot be sourced.
# NOTE: if you plan to IMPORT staging data (PROD_DEPLOYMENT.md appendix), reuse
# the SAME ENCRYPTION_KEY value staging uses, or any data it encrypted becomes
# unreadable.
SECRET_KEY=CHANGE-ME
ENCRYPTION_KEY=CHANGE-ME

# Third-party providers. Search & Discovery needs ONE of:
#   SERPAPI_KEY (recommended - hosted Bing v7 was retired in Aug 2025)
#   GOOGLE_SEARCH_API_KEY + GOOGLE_SEARCH_ENGINE_ID
#   BING_SEARCH_API_KEY (only if you have a v7-compatible endpoint; see
#   BING_SEARCH_ENDPOINT in backend/app/core/config.py)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Email sending (Phase 3) - any SMTP provider, e.g. Gmail app password:
# Before sending real outreach, publish SPF/DKIM/DMARC for your domain
# (PROD_DEPLOYMENT.md, "Email deliverability").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourcompany.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=you@yourcompany.com

# Reply detection (Phase 4) - IMAP of the same mailbox:
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@yourcompany.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Follow-up sequences (Phase 5):
FOLLOW_UP_ENABLED=true
FOLLOW_UP_AFTER_DAYS=4
FOLLOW_UP_MAX_COUNT=2
SERPAPI_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BING_SEARCH_API_KEY=

# ---- backups (optional, used by /opt/smart-reach-ai-prod/backup.sh) ----
# Set after creating the S3 bucket; leave empty to keep local-only backups.
#   aws s3 mb s3://your-company-srcai-backups
BACKUP_S3_BUCKET=
