# =============================================================================
# AI Lead Generation Platform - Environment Variables Template
# =============================================================================
# Copy this file to .env and configure for your environment
# For Docker: docker-compose.yml provides these variables
# For Local: Configure with your local database settings

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=AI Lead Generation Platform
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Security (CHANGE IN PRODUCTION!)
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-this-to-a-32-byte-url-safe-base64-encoded-key

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# For Local Development: mariadb+aiomysql://user:password@localhost:3306/dbname
# For Docker: mariadb+aiomysql://leadgen_user:leadgen_pass@db:3306/leadgen_db
DATABASE_URL=mariadb+aiomysql://user:password@localhost:3306/leadgen_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# For Local Development: redis://localhost:6379/0
# For Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://frontend:3000,http://backend:8000

# -----------------------------------------------------------------------------
# Email Providers (configure at least one)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_SENDER_EMAIL=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI Providers (configure at least one)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# Search Providers (configure at least one)
# -----------------------------------------------------------------------------
BING_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
SERPAPI_KEY=

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
STATSD_HOST=
STATSD_PORT=8125
