# =============================================================================
# SmartReach AI on Kubernetes - SECRET template.
# Copy to secrets.env, fill real values, then:
#   kubectl -n smartreach create secret generic smartreach-env \
#     --from-env-file=infra/k8s/secrets.env
# secrets.env is gitignored - NEVER commit it or put these into a YAML.
# =============================================================================
# Database (the MySQL container AND the app both read this file).
# NOTE: the password goes into DATABASE_URL too - URL-encode special
# characters (@ : / # ? %) or pick an alphanumeric password.
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_USER=leadgen_user
MYSQL_PASSWORD=change-me-strong-app-password
MYSQL_DATABASE=leadgen_db
DATABASE_URL=mysql+aiomysql://leadgen_user:change-me-strong-app-password@mysql:3306/leadgen_db

# Security
SECRET_KEY=generate-a-long-random-string
ENCRYPTION_KEY=

# Search provider
SERPAPI_KEY=

# AI providers (at least one to enable qualification/emails/assistant)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional fallback - used automatically when Gemini hits its rate limit.
# Paid/prepaid: get a key at https://console.x.ai
GROK_API_KEY=

# Email sending (SMTP) - required for outreach
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# Reply detection (IMAP) - optional
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Follow-ups (sane defaults)
FOLLOW_UP_ENABLED=true
FOLLOW_UP_AFTER_DAYS=4
FOLLOW_UP_MAX_COUNT=2
