# =============================================================================
# Staging environment template - SmartReach AI
# =============================================================================
# Copy to ./.staging.env (next to docker-compose.yml) and fill in real values.
#
#   Laptop / one-off server:   cp .staging.env.example .staging.env
#   Staging VM (CI deploys):   sudo cp <this> /opt/smart-reach-ai-staging/.staging.env
#
# NEVER commit the real .staging.env - it is gitignored on purpose.
# Do NOT set IMAGE_TAG here; the pipeline exports it per deploy.
# =============================================================================

# ---- used by docker-compose.yml interpolation (URLs as users see them) ----
# These are the staging VM addresses (reachable from the hypervisor host).
API_URL=http://192.168.1.30:8000
FRONTEND_URL=http://192.168.1.30:3000
CORS_ORIGINS=http://192.168.1.30:3000

# NEXT_PUBLIC_API_URL is NOT set here - it is a GitHub repo *variable*
# (Settings > Secrets and variables > Actions > Variables), baked into the
# frontend bundle at build time. Set it to http://192.168.1.30:8000.
# The workflow falls back to exactly that URL if the variable is unset.
DB_NAME=leadgen_db
DB_USER=leadgen_user
DB_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# ---- injected into backend/worker/scheduler containers ----
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=generate-with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Third-party providers - copy any you use from .env.production:
OPENAI_API_KEY=
SMTP_PASSWORD=
BING_SEARCH_API_KEY=
