# =============================================================================
# Production Environment Variables - Docker Compose Override
# =============================================================================
# Usage: docker-compose -f docker-compose.yml --env-file .env.production up -d
#
# This file contains production values that override docker-compose.yml defaults
# Copy this file and customize with your production values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=production
APP_NAME=AI Lead Generation Platform
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# Security (CHANGE THESE IN PRODUCTION!)
# -----------------------------------------------------------------------------
# Generate strong keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-KEY-IN-PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=CHANGE-THIS-TO-A-32-BASE64-ENCODED-KEY

# -----------------------------------------------------------------------------
# Database (Use docker-compose defaults - override if using external DB)
# -----------------------------------------------------------------------------
# For Docker database: keep docker-compose.yml defaults
# For external database: DATABASE_URL=mariadb+aiomysql://user:pass@external-host:3306/db

# -----------------------------------------------------------------------------
# Redis (Use docker-compose defaults - override if using external Redis)
# -----------------------------------------------------------------------------
# For Docker redis: keep docker-compose.yml defaults
# For external redis: REDIS_URL=redis://external-host:6379/0

# -----------------------------------------------------------------------------
# CORS (Update with your production domains)
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# Email Providers (Configure at least one)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true

# AWS SES
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# SES_SENDER_EMAIL=verified-sender@yourdomain.com

# Gmail API
# GMAIL_CLIENT_ID=your-client-id
# GMAIL_CLIENT_SECRET=your-client-secret

# Microsoft Graph
# MICROSOFT_CLIENT_ID=your-client-id
# MICROSOFT_CLIENT_SECRET=your-client-secret

# -----------------------------------------------------------------------------
# AI Providers (Configure at least one)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4-turbo-preview

# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# Search Providers (Configure at least one)
# -----------------------------------------------------------------------------
BING_SEARCH_API_KEY=your-bing-key

# GOOGLE_SEARCH_API_KEY=your-google-key
# GOOGLE_SEARCH_ENGINE_ID=your-engine-id

# SERPAPI_KEY=your-serpapi-key

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=your-sentry-dsn
# STATSD_HOST=your-statsd-server
# STATSD_PORT=8125
