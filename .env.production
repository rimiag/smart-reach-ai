# =============================================================================
# Production environment - SmartReach AI (app URL: reachpulse.medidatalab.com)
# =============================================================================
# This is YOUR working copy of the prod values. The deploy pipeline reads the
# file from the EC2 at /opt/smart-reach-ai-prod/.prod.env, so once filled in:
#
#   scp .env.production <ec2>:/opt/smart-reach-ai-prod/.prod.env
#
# (or create it directly on the EC2 with nano). Template: .prod.env.example.
# Full guide: PROD_DEPLOYMENT.md.
#
# NEVER commit this file with real values - it is gitignored on purpose
# (run `git rm --cached .env.production` once so git forgets the template).
# Do NOT set IMAGE_TAG here; the pipeline exports it per deploy.
# Values must be plain text (no spaces/quotes) or the file cannot be sourced.
# =============================================================================

# ---- URLs as users see them ----
API_URL=https://api.medidatalab.com
FRONTEND_URL=https://reachpulse.medidatalab.com
# Comma-separated list (backend splits on ",").
CORS_ORIGINS=https://reachpulse.medidatalab.com

# NEXT_PUBLIC_API_URL is NOT set here - it is a GitHub *Environment* variable
# on the "production" environment (Settings > Environments > production),
# baked into the frontend bundle at build time. Set it to:
#   https://api.medidatalab.com

# ---- Database (containers on the EC2) ----
DB_NAME=leadgen_db
DB_USER=leadgen_user
DB_PASSWORD=CHANGE-ME-strong-db-password
MYSQL_ROOT_PASSWORD=CHANGE-ME-strong-root-password

# ---- Security (REQUIRED) ----
# Generate:
#   SECRET_KEY:      python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   ENCRYPTION_KEY:  python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=CHANGE-ME
ENCRYPTION_KEY=CHANGE-ME
# Defaults are fine; override only if you want different session lifetimes.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Third-party providers ----
# Search: SerpAPI is the active provider (Google CSE is 403-blocked on this
# account; hosted Bing v7 was retired Aug 2025).
SERPAPI_KEY=CHANGE-ME-or-copy-from-laptop-.env
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# BING_SEARCH_API_KEY=

# AI (optional - features degrade gracefully without them)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Email sending (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@medidatalab.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=you@medidatalab.com

# ---- Reply detection (IMAP, same mailbox) ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@medidatalab.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---- Follow-up sequences ----
FOLLOW_UP_ENABLED=true
FOLLOW_UP_AFTER_DAYS=4
FOLLOW_UP_MAX_COUNT=2

# ---- Backups (optional, used by /opt/smart-reach-ai-prod/backup.sh) ----
#   aws s3 mb s3://your-company-srcai-backups
BACKUP_S3_BUCKET=
